# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
#
# Local development:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/crm_db?schema=public"
#
# Neon (or any serverless Postgres with a connection pooler):
#   DATABASE_URL  -> pooled connection (host contains "-pooler"), used by the app.
#   DIRECT_URL    -> direct connection (no "-pooler"), used by prisma migrate.
# Example:
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
#   DIRECT_URL="postgresql://user:pass@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/crm_db?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/crm_db?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="CRM Pro"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Optional: File uploads (if using cloud storage) ──────────────────────────
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
# AWS_REGION=""

# ─── Optional: Email (if using email notifications) ───────────────────────────
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
